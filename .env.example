# Copy to .env.local (never committed) and fill in. Set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Server only. Never expose this one to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use the sk_test_ key while testing)
STRIPE_SECRET_KEY=
# Locally: printed by `stripe listen`. In production: Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Public address of the site, used for Stripe return links
SITE_URL=http://localhost:5173

# Set to 1 after enabling the Google provider in Supabase (Authentication → Sign In / Providers → Google)
VITE_GOOGLE_AUTH=
